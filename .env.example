# DB Configuration
# Options: oracle, postgres
DB_TYPE=postgres

# Common
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=postgres

# Oracle Specific
DB_SERVICE_NAME=ORCLPDB1

# Seed
# Set to true to force re-seed even if data already exists.
# If not set, seed only runs when the target tables are empty.
SEED_ENABLED=false
